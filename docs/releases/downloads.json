{
  "schema_version": 1,
  "enabled": false,
  "channel": "stable",
  "status": "local-testing-only",
  "repository": {
    "owner": "ahmadrubai",
    "owner_verification": "configured-account-only",
    "name": "SleepChord",
    "planned_visibility": "private",
    "origin": "https://github.com"
  },
  "release": {
    "version": "2.0.1",
    "tag_template": "v{version}"
  },
  "assets": {
    "windows_x64": "SleepChord-Setup-{version}-x64.exe",
    "checksums": "SHA256SUMS.txt",
    "corresponding_source": "SleepChord-{version}-windows-x64-source.zip"
  },
  "routes": {
    "repository": "/{owner}/{repo}",
    "version_release": "/{owner}/{repo}/releases/tag/{tag}",
    "latest_stable": "/{owner}/{repo}/releases/latest",
    "download_asset": "/{owner}/{repo}/releases/download/{tag}/{asset}",
    "release_notes": "/{owner}/{repo}/releases/tag/{tag}"
  }
}
